# Copy this file to .env and fill in your real values.
# Do NOT commit your .env file.

# Server port
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Redis connection string for BullMQ (used by background AI queue).
# Optional for local development: leave unset to use synchronous AI processing instead of queued jobs.
# Example: redis://localhost:6379
REDIS_URL=
# Optional: explicitly disable BullMQ even when REDIS_URL is configured.
DISABLE_AI_QUEUE=false

# JWT signing secret for access tokens
JWT_SECRET=your_jwt_secret_here_minimum_64_chars
# JWT signing secret for refresh tokens
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_64_chars

# Primary AI provider name
# Options: groq | huggingface | nvidia | openrouter
AI_PROVIDER=groq

# Optional: use a different provider just for career-path generation.
# Example: keep chat on groq, but use openrouter only for roadmap/career-plan generation.
CAREER_PATH_PROVIDER=

# --- GROQ ---
# Groq API key
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (set these to Llama or Qwen model IDs available in your Groq account)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_HEAVY_MODEL=llama-3.1-8b-instant
# Optional per-feature models (use these if you want Qwen for specific tasks)
GROQ_SKILLGAP_MODEL=
GROQ_ROADMAP_MODEL=
GROQ_RESUME_MODEL=
GROQ_REASONING_MODEL=

# --- HUGGING FACE (Inference Providers) ---
# Create a token at https://huggingface.co/settings/tokens
# Required when AI_PROVIDER=huggingface (or when you explicitly request provider=huggingface)
HUGGINGFACE_API_KEY=your_hf_token_here
HUGGINGFACE_API_KEY_2=
HF_API_TOKEN=
HF_TOKEN=
# Default model IDs (you will choose these later)
HF_MODEL=
HF_CHAT_MODEL=
HF_HEAVY_MODEL=
HF_RESUME_MODEL=
# Skill Gap model (Hugging Face only)
HF_SKILLGAP_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
# Vision model for screenshot / image prompts
HF_VISION_MODEL=moonshotai/Kimi-K2.6:novita
# Generation tuning
HF_TEMPERATURE=0.4
HF_MAX_NEW_TOKENS=512
HF_SKILLGAP_MAX_NEW_TOKENS=256
HF_RETRY_COUNT=2
HF_RETRY_DELAY_MS=800
# Timeout for each AI provider call in milliseconds.
# In no-Redis mode, career plan generation may involve multiple AI calls inside one HTTP request.
AI_TIMEOUT_MS=45000

# --- NVIDIA OpenAI-Compatible Fallback ---
# Required when FALLBACK_AI_PROVIDER=nvidia or AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_CHAT_MODEL=
NVIDIA_HEAVY_MODEL=
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.9
NVIDIA_MAX_TOKENS=16384

# --- OPENROUTER ---
# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_CHAT_MODEL=
OPENROUTER_ROADMAP_MODEL=
OPENROUTER_HEAVY_MODEL=
OPENROUTER_TEMPERATURE=1
OPENROUTER_TOP_P=1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_REASONING_ENABLED=true

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Email account used for verification and reset emails
EMAIL_USER=
# App password or SMTP password for the email account
EMAIL_PASS=
